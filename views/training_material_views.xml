<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="training_material_form" model="ir.ui.view">
        <field name="name">training.material.form</field>
        <field name="model">training.material</field>
        <field name="arch" type="xml">
            <form string="Material de Capacitación">
                <sheet>
                    <field name="file_url" invisible="1"/>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="course_id"/>
                            <field name="material_type"/>
                        </group>
                        <group>
                            <field name="file" filename="file_name" widget="binary"/>
                            <field name="file_name" invisible="1"/>
                            <field name="allow_download"/>
                            <field name="duration"/>
                            <field name="sequence"/>
                        </group>
                    </group>

                    <field name="description" placeholder="Descripción del material..."/>

                    <field name="content_text"
                           attrs="{'invisible': [('material_type', '!=', 'text')]}"/>

                    <notebook attrs="{'invisible': [('material_type', '!=', 'video')]}">
                        <page string="Reproductor de Video">
                            <div style="min-height: 520px; margin-top: 15px;">
                                <!-- El widget JS maneja el src dinámicamente, sin depender de t-att-src -->
                                <field name="file"
                                       widget="video_player"
                                       nolabel="1"
                                       style="width: 100%; display: block;"/>
                            </div>
                        </page>
                    </notebook>

                    <notebook attrs="{'invisible': [('material_type', '!=', 'audio')]}">
                        <page string="Reproductor de Audio">
                            <div style="width: 100%; margin-top: 15px;">
                                <div attrs="{'invisible': [('file_url', '=', False)]}" style="padding: 10px 0;">
                                    <audio controls="controls" controlsList="nodownload" preload="auto" style="width: 100%; display: block;" t-att-src="file_url">
                                        El navegador no soporta la reproducción de audio nativa.
                                    </audio>
                                </div>
                                <div attrs="{'invisible': [('file_url', '!=', False)]}" 
                                     style="color: #666666; text-align: center; padding: 40px 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: #f9f9f9;">
                                    <p attrs="{'invisible': [('file', '!=', False)]}">
                                        Por favor, cargue un archivo de audio para habilitar el reproductor.
                                    </p>
                                    <p attrs="{'invisible': ['|', ('file', '=', False), ('id', '!=', False)]}" style="color: #444444;">
                                        Guarde el registro del curso para procesar y reproducir el audio adjunto.
                                    </p>
                                </div>
                            </div>
                        </page>
                    </notebook>

                    <notebook attrs="{'invisible': [('material_type', '!=', 'pdf')]}">
                        <page string="Visualización de Documento">
                            <div style="width: 100%; min-height: 740px; margin-top: 15px;">
                                <field name="file" 
                                       widget="pdf_viewer" 
                                       nolabel="1" 
                                       style="width: 100%; height: 720px; display: block;"
                                       attrs="{'invisible': ['|', ('file', '=', False), ('id', '=', False)]}"/>
                                
                                <div attrs="{'invisible': [('file', '!=', False), ('id', '!=', False)]}" 
                                     style="color: #666666; text-align: center; padding: 80px 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: #f9f9f9;">
                                    <p attrs="{'invisible': [('file', '!=', False)]}">
                                        Por favor, cargue un archivo PDF para habilitar la vista previa del documento.
                                    </p>
                                    <p attrs="{'invisible': ['|', ('file', '=', False), ('id', '!=', False)]}" style="color: #444444;">
                                        Guarde el registro del curso para generar la vista previa del documento PDF.
                                    </p>
                                </div>
                            </div>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>